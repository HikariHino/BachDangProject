    {
      "line": "Tôi đang kiểm lại hàng trước khi mang sang doanh trại.",
      "male": "BachDang938/Voices/3c5d3197ffe0496f8c7a_m",
      "female": "BachDang938/Voices/3c5d3197ffe0496f8c7a_f",
      "variants": [
        {
          "profile": "merchant_m",
