    {
      "line": "Quân Nam Hán đang dòm ngó bờ cõi. Chúng tôi sẽ giữ vững doanh trại để Chủ tướng yên tâm lo kế sách.",
      "male": "BachDang938/Voices/9f3406759854ea3fee08_m",
      "female": "BachDang938/Voices/9f3406759854ea3fee08_f",
      "variants": [
        {
          "profile": "soldier",
          "path": "BachDang938/Voices/NativeCast/5d375e444fd6149ac86f_soldier"
        },
        {
          "profile": "veteran",
          "path": "BachDang938/Voices/NativeCast/ffe421c76264c022a01d_veteran"
        }
      ]
    },
    {
      "line": "Quân Nam Hán đang lăm le xâm phạm bờ cõi. Hãy đến làng ven sông, cùng bà con chuẩn bị gỗ làm cọc. Ta trông cậy vào ngươi.",
      "male": "BachDang938/Voices/69b47aad5e7ca02178f5_m",
      "female": "BachDang938/Voices/69b47aad5e7ca02178f5_f",
      "variants": [
        {
          "profile": "commander",
          "path": "BachDang938/Voices/NativeCast/df5d00944d6e3f02b11c_commander"
        }
      ]
    },
    {
      "line": "Quân Nam Hán đã kéo thuyền đến xâm phạm. Trận địa cọc đã sẵn sàng. Hãy lên thuyền chỉ huy, chờ thủy triều rút - bãi cọc sẽ lộ ra đâm thủng thuyền giặc. Ta sẽ đại thắng ngay trên sông Bạch Đằng hôm nay!",
      "male": "BachDang938/Voices/2ce318a5b6d03f61d503_m",
      "female": "BachDang938/Voices/2ce318a5b6d03f61d503_f",
      "variants": [
        {
          "profile": "commander",
          "path": "BachDang938/Voices/NativeCast/4c5a3c4f0571b0e27e81_commander"
        }
      ]
    },
    {
      "line": "Ruộng ngoài bãi phù sa tốt lắm, mùa này lúa lên đều.",
      "male": "BachDang938/Voices/a2ea2b6b0bc4a4610eac_m",
      "female": "BachDang938/Voices/a2ea2b6b0bc4a4610eac_f",
      "variants": [
        {
          "profile": "farmer_m",
          "path": "BachDang938/Voices/NativeCast/7595a4b62580275b2532_farmer_m"
