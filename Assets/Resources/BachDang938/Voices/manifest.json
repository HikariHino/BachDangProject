    {
      "line": "Quân Nam Hán đang dòm ngó bờ cõi. Chúng tôi sẽ giữ vững doanh trại để Chủ tướng yên tâm lo kế sách.",
      "male": "BachDang938/Voices/9f3406759854ea3fee08_m",
      "female": "BachDang938/Voices/9f3406759854ea3fee08_f",
      "variants": [
