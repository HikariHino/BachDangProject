          "path": "BachDang938/Voices/NativeCast/09b4f0e9ee2ad8f1a255_fisher_f"
        }
      ]
    },
    {
      "line": "Trận địa cọc đã hoàn thành. Toàn quân hãy giữ kín kế hoạch, chờ thủy triều và thời cơ đánh giặc!",
      "male": "BachDang938/Voices/2db1efd2985557c80c04_m",
      "female": "BachDang938/Voices/2db1efd2985557c80c04_f",
      "variants": [
        {
          "profile": "commander",
          "path": "BachDang938/Voices/NativeCast/fd4e06fcedf5d34752b8_commander"
        }
      ]
    },
    {
      "line": "Tôi đang chuyển bó củi này sang bếp trại.",
      "male": "BachDang938/Voices/132013b59fd553dfc582_m",
      "female": "BachDang938/Voices/132013b59fd553dfc582_f",
      "variants": [
        {
          "profile": "porter_m",
          "path": "BachDang938/Voices/NativeCast/9d6f6ea28cc1577f7e31_porter_m"
        },
        {
          "profile": "porter_f",
          "path": "BachDang938/Voices/NativeCast/95a7c7f949a0152fbb87_porter_f"
        }
      ]
    },
    {
      "line": "Tôi đang chuyển cá vào chợ trước khi nắng lên.",
      "male": "BachDang938/Voices/f102c895988798529ab6_m",
      "female": "BachDang938/Voices/f102c895988798529ab6_f",
      "variants": [
        {
          "profile": "fisher_m",
          "path": "BachDang938/Voices/NativeCast/8bb087791322ceccf0e5_fisher_m"
        },
        {
          "profile": "fisher_f",
          "path": "BachDang938/Voices/NativeCast/61fb9797b577e1e40258_fisher_f"
        }
      ]
    },
    {
      "line": "Tôi đang kiểm lại hàng trước khi mang sang doanh trại.",
      "male": "BachDang938/Voices/3c5d3197ffe0496f8c7a_m",
      "female": "BachDang938/Voices/3c5d3197ffe0496f8c7a_f",
      "variants": [
        {
          "profile": "merchant_m",
          "path": "BachDang938/Voices/NativeCast/3a4df8f30d84be603767_merchant_m"
        },
        {
          "profile": "merchant_f",
          "path": "BachDang938/Voices/NativeCast/6fbaebc5daddf17c5b49_merchant_f"
        }
      ]
    },
    {
      "line": "Tôi đang mang nông cụ ra đồng rồi sẽ về phơi thóc.",
      "male": "BachDang938/Voices/30453a361bda848897c9_m",
      "female": "BachDang938/Voices/30453a361bda848897c9_f",
      "variants": [
        {
          "profile": "farmer_m",
          "path": "BachDang938/Voices/NativeCast/82e2f9c10f5ea58935bf_farmer_m"
        },
        {
          "profile": "farmer_f",
          "path": "BachDang938/Voices/NativeCast/f9c91da36dbd01268bf9_farmer_f"
        }
      ]
    },
    {
      "line": "Tôi đang tuần tra từ cổng đến kho lương.",
      "male": "BachDang938/Voices/dbb373dc2433b4a76ce0_m",
      "female": "BachDang938/Voices/dbb373dc2433b4a76ce0_f",
      "variants": [
        {
          "profile": "soldier",
          "path": "BachDang938/Voices/NativeCast/a99dbaea9c80c171e5c9_soldier"
        },
        {
          "profile": "veteran",
          "path": "BachDang938/Voices/NativeCast/b183ee3d52a66a74fab4_veteran"
        }
      ]
    },
    {
      "line": "Tôi đang tôi lại mũi giáo, tránh để thép quá giòn.",
      "male": "BachDang938/Voices/1acf8f106abb5a9bbd22_m",
      "female": "BachDang938/Voices/1acf8f106abb5a9bbd22_f",
      "variants": [
        {
          "profile": "smith_m",
          "path": "BachDang938/Voices/NativeCast/32a1a2184fa2ad7234db_smith_m"
        },
        {
          "profile": "smith_f",
          "path": "BachDang938/Voices/NativeCast/232578c3e3f8cdf9384a_smith_f"
        }
      ]
    },
    {
      "line": "Tốt lắm. Mang năm cọc này qua cổng ra bến, rồi lên thuyền. Chèo tới năm điểm đánh dấu ngoài sông. Ở mỗi điểm, dừng thuyền và bấm E để cùng quân sĩ dựng một cụm cọc. Làm đủ cả năm cụm rồi chèo về bến báo cáo. Triều rút sẽ lộ cọc, triều lên sẽ giấu kín trận địa. Việc này quyết định thắng bại.",
      "male": "BachDang938/Voices/93e8e322fa42dad128a1_m",
      "female": "BachDang938/Voices/93e8e322fa42dad128a1_f",
      "variants": [
        {
          "profile": "commander",
          "path": "BachDang938/Voices/NativeCast/5a6bb51dceaaf8a36072_commander"
        }
      ]
    },
    {
      "line": "Vật tư đã được tập kết đầy đủ.",
      "male": "BachDang938/Voices/74d98d1205fade5305cf_m",
      "female": "BachDang938/Voices/74d98d1205fade5305cf_f",
      "variants": [
        {
          "profile": "villager_m",
          "path": "BachDang938/Voices/NativeCast/61a9b6a7e3465cc7a4ea_villager_m"
        },
        {
          "profile": "villager_f",
          "path": "BachDang938/Voices/NativeCast/b37b1cda7607d9a68cef_villager_f"
        },
        {
          "profile": "villager_alt_m",
          "path": "BachDang938/Voices/NativeCast/8bd7cad1f0c31904f8a1_villager_alt_m"
        },
        {
          "profile": "villager_alt_f",
          "path": "BachDang938/Voices/NativeCast/bc317e6275d889ee1f37_villager_alt_f"
        }
      ]
    },
    {
      "line": "Đã vớt lại đủ cọc và siết chặt dây buộc. Tiếp tục hoàn thành hai cụm còn lại.",
      "male": "BachDang938/Voices/db16f09574ef38290322_m",
      "female": "BachDang938/Voices/db16f09574ef38290322_f",
      "variants": [
        {
          "profile": "soldier",
          "path": "BachDang938/Voices/NativeCast/763b533e34c87b4519c4_soldier"
        },
        {
          "profile": "veteran",
          "path": "BachDang938/Voices/NativeCast/6bf3f274b48fae0bc52a_veteran"
        }
      ]
    },
    {
      "line": "Đường qua cổng đã dọn trống, xe hàng có thể đi lại.",
      "male": "BachDang938/Voices/aacd27e55abe4acad369_m",
      "female": "BachDang938/Voices/aacd27e55abe4acad369_f",
      "variants": [
        {
          "profile": "porter_m",
          "path": "BachDang938/Voices/NativeCast/4cade747129240a9d795_porter_m"
        },
        {
          "profile": "porter_f",
          "path": "BachDang938/Voices/NativeCast/f661c1f7b659f387d1ce_porter_f"
        }
      ]
    },
    {
      "line": "Đại thắng! Quân Nam Hán bị đánh tan trên sông Bạch Đằng. Từ nay, nước Việt ta bước vào thời kỳ độc lập, tự chủ. Toàn quân trở về đại bản doanh báo công!",
      "male": "BachDang938/Voices/e0b1617d57a8dbf3e14e_m",
      "female": "BachDang938/Voices/e0b1617d57a8dbf3e14e_f",
      "variants": [
        {
          "profile": "commander",
          "path": "BachDang938/Voices/NativeCast/f20cc385f57876a41a39_commander"
        }
      ]
    },
    {
      "line": "Đại thắng! Quân dân cùng trở về doanh trại, nổi trống mừng nền tự chủ của nước Việt.",
      "male": "BachDang938/Voices/eb7abf4ff66452e21bc7_m",
      "female": "BachDang938/Voices/eb7abf4ff66452e21bc7_f",
      "variants": [
        {
          "profile": "villager_m",
          "path": "BachDang938/Voices/NativeCast/349c3aff4e5213f07b97_villager_m"
        },
        {
          "profile": "villager_f",
          "path": "BachDang938/Voices/NativeCast/114e358b59bf7c3095f4_villager_f"
        },
        {
          "profile": "villager_alt_m",
          "path": "BachDang938/Voices/NativeCast/f1dd20b5680e0554a026_villager_alt_m"
        },
        {
          "profile": "villager_alt_f",
          "path": "BachDang938/Voices/NativeCast/b6dac6236cb3f3ee9dd0_villager_alt_f"
        }
      ]
    },
    {
      "line": "Năm 938.",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "narrator",
          "path": "BachDang938/Voices/NativeCast/d8b2ce56f179a3d95269_narrator"
        }
      ]
    },
    {
      "line": "Sau nhiều năm đất nước chìm trong thời kỳ Bắc thuộc, vùng đất Giao Châu vẫn đang đứng trước những biến động lớn.",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "narrator",
          "path": "BachDang938/Voices/NativeCast/a9a271a93913a57bed53_narrator"
        }
      ]
    },
    {
      "line": "Nhà Nam Hán ở phương Bắc đang tìm cách đưa quân tiến xuống Giao Châu, với ý định giành lại quyền kiểm soát vùng đất này.",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "narrator",
          "path": "BachDang938/Voices/NativeCast/57f2a5b1843b69ca86dc_narrator"
        }
      ]
    },
    {
      "line": "Trước nguy cơ xâm lược, Ngô Quyền tập hợp lực lượng, chuẩn bị chống lại quân Nam Hán.",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "narrator",
          "path": "BachDang938/Voices/NativeCast/18d0a68da1643a51ebf5_narrator"
        }
      ]
    },
    {
      "line": "Ngô Quyền lựa chọn sông Bạch Đằng làm nơi quyết chiến.",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "narrator",
          "path": "BachDang938/Voices/NativeCast/ef912f7dca51dbfff5d8_narrator"
        }
      ]
    },
    {
      "line": "Tại đây, quân ta chuẩn bị một kế sách dựa vào địa hình và thủy triều của dòng sông.",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "narrator",
          "path": "BachDang938/Voices/NativeCast/7491e8bdbf026b0b1799_narrator"
        }
      ]
    },
    {
      "line": "Những cọc gỗ được đẽo nhọn và bố trí dưới lòng sông, chờ thời cơ thích hợp.",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "narrator",
          "path": "BachDang938/Voices/NativeCast/5248b89b4683ab82fca1_narrator"
        }
      ]
    },
    {
      "line": "Nhưng trước khi trận chiến bắt đầu...",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "narrator",
          "path": "BachDang938/Voices/NativeCast/5a0f7ade92aa28ead575_narrator"
        }
      ]
    },
    {
      "line": "Ngươi hãy chèo thuyền nhẹ ra nhử địch. Khi chúng đuổi theo, dẫn cả hạm đội vào bãi cọc rồi rút qua lối quân ta. Chờ nước rút và hiệu lệnh mới phản công!",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "commander_brief",
          "path": "BachDang938/Voices/Preparation/ngo_lure"
        }
      ]
    },
    {
      "line": "Trước khi đi nhử địch, ngươi phải tập bắn cung. Đến bãi tập, bấm E và bắn trúng ít nhất bốn trong sáu bia, rồi quay lại nhận lệnh.",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "commander_brief",
          "path": "BachDang938/Voices/Preparation/ngo_archery"
        }
      ]
    },
    {
      "line": "Giữ chắc cọc! Một, hai, nện!",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "crew_work",
          "path": "BachDang938/Voices/Preparation/crew_hold"
        }
      ]
    },
    {
      "line": "Cọc đã chắc! Chuyển sang hàng tiếp theo!",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "crew_work",
          "path": "BachDang938/Voices/Preparation/crew_move"
        }
      ]
    },
    {
      "line": "Trước khi đi nhử địch, ngươi phải luyện cung. Hãy đến bãi tập trong doanh trại, bắn trúng ít nhất bốn trong sáu bia, rồi quay lại nhận lệnh.",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "commander_brief",
          "path": "BachDang938/Voices/Preparation/ngo_archery_natural"
        }
      ]
    },
    {
      "line": "Mang cọc ra bến. Chèo tới đủ năm vị trí ngoài sông, mỗi nơi dựng một cọc mẫu, chỉnh đúng góc và nện thật chắc. Quân dân sẽ theo mẫu hoàn thiện trận địa. Xong việc, trở về báo cáo với ta.",
      "male": "",
      "female": "",
      "variants": [
        {
          "profile": "commander_brief",
          "path": "BachDang938/Voices/Preparation/ngo_stakes_five"
        }
      ]
    }
  ],
