          "profile": "farmer_f",
          "path": "BachDang938/Voices/NativeCast/c7b7a24194910453af83_farmer_f"
        }
      ]
    },
    {
      "line": "Sáng sớm cá về nhiều, tôi đang sửa lưới để kịp chuyến sau.",
      "male": "BachDang938/Voices/4fb644893f4b6b8b7fb2_m",
      "female": "BachDang938/Voices/4fb644893f4b6b8b7fb2_f",
