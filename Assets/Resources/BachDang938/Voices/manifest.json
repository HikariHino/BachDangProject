        },
        {
          "profile": "merchant_f",
          "path": "BachDang938/Voices/Cast/deec6dc68957ae39f60e_merchant_f"
        }
      ]
    },
    {
      "line": "Tôi đang mang nông cụ ra đồng rồi sẽ về phơi thóc.",
      "male": "BachDang938/Voices/30453a361bda848897c9_m",
      "female": "BachDang938/Voices/30453a361bda848897c9_f",
      "variants": [
        {
          "profile": "farmer_m",
          "path": "BachDang938/Voices/Cast/5ddade81a39271dfec4b_farmer_m"
        },
        {
          "profile": "farmer_f",
          "path": "BachDang938/Voices/Cast/24dc9957af2ad712d77e_farmer_f"
        }
      ]
    },
    {
      "line": "Tôi đang tuần tra từ cổng đến kho lương.",
      "male": "BachDang938/Voices/dbb373dc2433b4a76ce0_m",
      "female": "BachDang938/Voices/dbb373dc2433b4a76ce0_f",
      "variants": [
        {
          "profile": "soldier",
          "path": "BachDang938/Voices/Cast/1abf6ecf97fef6ba0548_soldier"
        },
        {
          "profile": "veteran",
          "path": "BachDang938/Voices/Cast/8d1b6810c4b11e06c0c5_veteran"
        }
      ]
    },
    {
      "line": "Tôi đang tôi lại mũi giáo, tránh để thép quá giòn.",
      "male": "BachDang938/Voices/1acf8f106abb5a9bbd22_m",
      "female": "BachDang938/Voices/1acf8f106abb5a9bbd22_f",
      "variants": [
        {
          "profile": "smith_m",
          "path": "BachDang938/Voices/Cast/05e4bba7c01acded226e_smith_m"
        },
        {
          "profile": "smith_f",
          "path": "BachDang938/Voices/Cast/abd28726cf7c77024d1e_smith_f"
        }
      ]
    },
    {
      "line": "Tốt lắm. Mang năm cọc này qua cổng ra bến, rồi lên thuyền. Chèo tới năm điểm đánh dấu ngoài sông. Ở mỗi điểm, dừng thuyền và bấm E để cùng quân sĩ dựng một cụm cọc. Làm đủ cả năm cụm rồi chèo về bến báo cáo. Triều rút sẽ lộ cọc, triều lên sẽ giấu kín trận địa. Việc này quyết định thắng bại.",
      "male": "BachDang938/Voices/93e8e322fa42dad128a1_m",
      "female": "BachDang938/Voices/93e8e322fa42dad128a1_f",
      "variants": [
        {
          "profile": "commander",
          "path": "BachDang938/Voices/Cast/788c024caf9bf081f0f4_commander"
        }
      ]
    },
    {
      "line": "Vật tư đã được tập kết đầy đủ.",
      "male": "BachDang938/Voices/74d98d1205fade5305cf_m",
      "female": "BachDang938/Voices/74d98d1205fade5305cf_f",
      "variants": [
        {
          "profile": "villager_m",
          "path": "BachDang938/Voices/Cast/5014b74a66497da744c4_villager_m"
        },
        {
          "profile": "villager_f",
          "path": "BachDang938/Voices/Cast/70d67678cd7a905fe548_villager_f"
        },
        {
          "profile": "villager_alt_m",
          "path": "BachDang938/Voices/Cast/49798581a9c535fd76ca_villager_alt_m"
        },
        {
          "profile": "villager_alt_f",
          "path": "BachDang938/Voices/Cast/b7f0ec335ac2483e7e3c_villager_alt_f"
        }
      ]
    },
    {
      "line": "Đã vớt lại đủ cọc và siết chặt dây buộc. Tiếp tục hoàn thành hai cụm còn lại.",
      "male": "BachDang938/Voices/db16f09574ef38290322_m",
      "female": "BachDang938/Voices/db16f09574ef38290322_f",
      "variants": [
        {
          "profile": "soldier",
          "path": "BachDang938/Voices/Cast/e8c1df8410dcfaa70ef8_soldier"
        },
        {
          "profile": "veteran",
          "path": "BachDang938/Voices/Cast/7f3bed9f08a64cc8a234_veteran"
        }
      ]
    },
    {
      "line": "Đường qua cổng đã dọn trống, xe hàng có thể đi lại.",
      "male": "BachDang938/Voices/aacd27e55abe4acad369_m",
      "female": "BachDang938/Voices/aacd27e55abe4acad369_f",
      "variants": [
        {
          "profile": "porter_m",
          "path": "BachDang938/Voices/Cast/4892b9680252550a2815_porter_m"
        },
        {
          "profile": "porter_f",
          "path": "BachDang938/Voices/Cast/ba23ce3bf770d4d2dad6_porter_f"
        }
      ]
    },
    {
      "line": "Đại thắng! Quân Nam Hán bị đánh tan trên sông Bạch Đằng. Từ nay, nước Việt ta bước vào thời kỳ độc lập, tự chủ. Toàn quân trở về đại bản doanh báo công!",
      "male": "BachDang938/Voices/e0b1617d57a8dbf3e14e_m",
      "female": "BachDang938/Voices/e0b1617d57a8dbf3e14e_f",
      "variants": [
        {
          "profile": "commander",
          "path": "BachDang938/Voices/Cast/e84593456cd257f29fae_commander"
        }
      ]
    },
    {
      "line": "Đại thắng! Quân dân cùng trở về doanh trại, nổi trống mừng nền tự chủ của nước Việt.",
      "male": "BachDang938/Voices/eb7abf4ff66452e21bc7_m",
      "female": "BachDang938/Voices/eb7abf4ff66452e21bc7_f",
