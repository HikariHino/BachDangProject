          "profile": "commander",
          "path": "BachDang938/Voices/Cast/066663ee186851d1bd55_commander"
        }
      ]
    },
    {
      "line": "Ruộng ngoài bãi phù sa tốt lắm, mùa này lúa lên đều.",
